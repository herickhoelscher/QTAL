// Portal Institucional Multiconteúdo — B7
// Modelo de dados conforme seção 07 da especificação técnica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum CategoryType {
  ARTICLE
  EVENT
  PROPERTY
  VIDEO
}

enum PropertyType {
  CASA
  APARTAMENTO
  TERRENO
  COMERCIAL
  RURAL
}

enum VideoProvider {
  YOUTUBE
  INSTAGRAM
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles Article[]
}

model Category {
  id   String       @id @default(cuid())
  name String
  slug String
  type CategoryType

  articles   Article[]  @relation("ArticleCategories")
  events     Event[]    @relation("EventCategories")
  properties Property[] @relation("PropertyCategories")
  videos     Video[]    @relation("VideoCategories")

  @@unique([slug, type])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  subtitle        String?
  body            String        @db.Text
  coverImage      String?
  coverAlt        String?
  region          String?
  publishedAt     DateTime?
  status          ContentStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  viewCount       Int           @default(0)
  featured        Boolean       @default(false)
  /// Posicao nos destaques da secao (1 a 6). Null: fora dos destaques.
  featuredRank    Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId String?
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categories Category[]   @relation("ArticleCategories")
  gallery    MediaAsset[]
  videos     Video[]
  issueItems IssueItem[]
  heroSlides HeroSlide[]

  @@index([status, publishedAt])
}

/// Uma "edição" é a sequência de matérias consumida no Modo Revista.
model Issue {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String?
  coverImage   String?
  /// Posicao nos destaques da secao (1 a 6). Null: fora dos destaques.
  featuredRank Int?
  publishedAt  DateTime?
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items      IssueItem[]
  /// Paginas da revista folheavel, em ordem (position).
  pages      MediaAsset[]
  heroSlides HeroSlide[]
}

model IssueItem {
  id        String @id @default(cuid())
  issueId   String
  articleId String
  position  Int    @default(0)

  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([issueId, articleId])
  @@index([issueId, position])
}

model Event {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String?       @db.Text
  date         DateTime
  location     String?
  region       String?
  coverImage   String?
  coverAlt     String?
  /// Posicao nos destaques da secao (1 a 6). Null: fora dos destaques.
  featuredRank Int?
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  categories Category[]   @relation("EventCategories")
  media      MediaAsset[]
  videos     Video[]
  heroSlides HeroSlide[]

  @@index([status, date])
}

model Property {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  type           PropertyType
  city           String
  region         String?
  address        String?
  price          Decimal?      @db.Decimal(12, 2)
  priceOnRequest Boolean       @default(false)
  area           Float?
  bedrooms       Int?
  bathrooms      Int?
  garageSpots    Int?
  description    String?       @db.Text
  coverImage     String?
  coverAlt       String?
  mapEmbedUrl    String?
  tourUrl        String?
  featured       Boolean       @default(false)
  /// Posicao nos destaques da secao (1 a 6). Null: fora dos destaques.
  featuredRank   Int?
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categories Category[]   @relation("PropertyCategories")
  gallery    MediaAsset[]
  videos     Video[]
  heroSlides HeroSlide[]

  @@index([status, city, type])
}

/// Vídeo sempre hospedado externamente. Quando ligado a um Evento,
/// aparece tanto na página do evento quanto na listagem geral /videos.
model Video {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String?       @db.Text
  provider        VideoProvider
  externalUrl     String
  embedId         String
  customThumbnail String?
  /// Reels e Shorts sao 9:16 e ocupam a tela inteira no feed; o padrao (16:9)
  /// entra com tarja desfocada. Detectado pelo link no cadastro, editavel.
  vertical        Boolean       @default(false)
  featured        Boolean       @default(false)
  /// Posicao nos destaques da secao (1 a 6). Null: fora dos destaques.
  featuredRank    Int?
  publishedAt     DateTime?
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Um mesmo video pode ser ancorado a um evento, a uma materia e/ou a um
  // imovel. Nao e copia: e o mesmo registro aparecendo em varios contextos,
  // e ele continua listado em /videos de qualquer forma.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  categories Category[]  @relation("VideoCategories")
  heroSlides HeroSlide[]

  @@index([status, publishedAt])
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  type      MediaType @default(IMAGE)
  width     Int?
  height    Int?
  altText   String?
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  articleId  String?
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  issueId    String?
  issue      Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  /// Foto de destaque: abre grande no topo da galeria. Uma por album.
  featured Boolean @default(false)

  /// Agrupamento opcional de fotos em blocos/álbuns dentro de um evento.
  album String?
}

/// Slide do carrossel do topo da home. Aponta para um conteudo de qualquer
/// tipo (exatamente uma das chaves preenchida); some junto com ele.
model HeroSlide {
  id        String   @id @default(cuid())
  position  Int      @default(0)
  createdAt DateTime @default(now())

  articleId  String?
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  videoId    String?
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  issueId    String?
  issue      Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([position])
}

/// Linha única de configuração operada pelo cliente no painel.
model ApiSettings {
  id                  String    @id @default("singleton")
  siteName            String    @default("Portal Institucional")
  siteDescription     String    @default("Eventos, matérias, imóveis e vídeos.")
  clientLogoUrl       String?
  weatherApiKey       String?
  /// Chave da API do DeepL (faixa gratis). Sem ela o site mostra o conteudo em portugues.
  deeplApiKey         String?
  weatherProvider     String    @default("openweathermap")
  weatherCity         String    @default("Toledo,PR,BR")
  weatherLat          Float?
  weatherLon          Float?
  currencyApiProvider String    @default("awesomeapi")
  cubValue            Decimal?  @db.Decimal(12, 2)
  cubReference        String?
  cubUpdatedAt        DateTime?
  /// Variacao percentual no mes, quando a fonte informa.
  cubChangePercent    Decimal?  @db.Decimal(6, 2)
  /// De onde veio o valor: "sinduscon", "sinapi" ou "manual".
  cubSource           String?
  /// Qual indice buscar: CUBOESTE/PR (regional) ou CUB/PR (estadual).
  cubIndex            String    @default("CUBOESTE/PR")
  /// Com isso ligado, o job mensal sobrescreve o valor com o do Sinduscon.
  cubAutoUpdate       Boolean   @default(true)
  gtmContainerId      String?
  whatsappNumber      String    @default("5545999999999")
  whatsappMessage     String    @default("Ola! Gostaria de assinar a revista.")
  instagramUrl        String?
  facebookUrl         String?
  youtubeUrl          String?
  contactPhone        String?
  contactEmail        String?
  contactAddress      String?
  updatedAt           DateTime  @default(now()) @updatedAt
}

/// Reservado para a evolução do fluxo de assinatura (hoje via WhatsApp).
model Subscriber {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String?
  email     String?
  createdAt DateTime @default(now())
}

/// Traducao automatica de um campo de conteudo (materia, evento, imovel...).
/// O portugues continua no proprio registro; aqui ficam so en e es.
model Translation {
  id         String   @id @default(cuid())
  locale     String
  /// "article" | "event" | "property" | "video" | "issue" | "category"
  model      String
  recordId   String
  field      String
  value      String   @db.Text
  /// SHA-256 do texto em portugues no momento da traducao: se o original
  /// mudar, o hash muda e o campo e retraduzido; se nao, nao gasta cota.
  sourceHash String
  updatedAt  DateTime @updatedAt

  @@unique([locale, model, recordId, field])
  @@index([model, recordId])
}
