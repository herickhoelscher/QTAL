# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/portal_bsec?schema=public"

# Segredo de assinatura da sessão do painel.
# Gere um novo para produção: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao"

# Endereço público do site (sitemap, robots, Open Graph e links de compartilhar).
# OPCIONAL: sem esta variável, o site usa o domínio de produção que a Vercel
# injeta na build. Só preencha quando houver domínio próprio — e aí com o
# endereço real, porque um valor errado aqui vence a detecção automática.
NEXT_PUBLIC_SITE_URL=""

# Armazenamento de mídia no Cloudflare Images.
# Sem estas duas variáveis, os uploads são gravados em public/uploads.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_TOKEN=""

# Clima e cotações não precisam de chave: o portal usa Open-Meteo (clima),
# AwesomeAPI (dólar) e a API do IBGE (custo do m²), todas gratuitas e abertas.
# A cidade do clima é configurada em /admin/configuracoes.

# Segredo do job mensal que busca o CUB (/api/cron/cub).
# A Vercel envia este valor no header Authorization ao disparar o cron.
# Sem ele em produção, a rota recusa qualquer chamada e o job não roda.
CRON_SECRET=""
